# The connection-bar switch picks one of these. No trailing slash.
NEXT_PUBLIC_PANTA_LIVE_API_URL=https://live-api.panta.market/api/v1
NEXT_PUBLIC_PANTA_STAGING_API_URL=https://staging-api.panta.market/api/v1

# Optional: public defaults shown in the UI (overridable in the connection bar)
NEXT_PUBLIC_DEFAULT_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_DOCS_URL=https://github.com/Kaito-HQ/panta-api-pub
